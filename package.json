{
  "name": "criptomonedas",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:full": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:apk": "node -e \"const{spawn}=require('child_process');const path=require('path');const cwd=path.resolve('android');const isWin=process.platform==='win32';const gradlew=path.join(cwd,isWin?'gradlew.bat':'gradlew');const cmd=isWin?'cmd':gradlew;const args=isWin?['/c',gradlew,'assembleRelease']:['assembleRelease'];const build=spawn(cmd,args,{stdio:'inherit',cwd});build.on('close',(code)=>{if(code!==0){console.error('Error en build:',code);process.exit(code);}const src=path.join(cwd,'app','build','outputs','apk','release','app-release.apk');const dst=path.join(cwd,'..','app-criptomonedas.apk');require('fs').copyFileSync(src,dst);console.log('APK copiada a',dst);});\"",
    "clean:deps": "node -e \"['android/app/build','android/app/.cxx','android/.gradle','android/build','node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true});console.log('Eliminado:',d);}catch(e){console.error('Error al eliminar',d,e.message);}})\""
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.87.1",
    "axios": "^1.21.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
